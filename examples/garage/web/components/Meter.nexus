---
interface Props {
  label: string;
  /** 0 to 100. */
  value: number;
  /** Drawn in the warning colour, for a value that needs attention. */
  low?: boolean;
}
---

<div class="meter" class:low={props.low}>
  <div class="row">
    <span class="label">{props.label}</span>
    <span class="value">{props.value}</span>
  </div>
  <div class="track">
    <div class="fill" style:width="{props.value}%"></div>
  </div>
</div>

<style>
  .meter {
    display: grid;
    gap: 8px;
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .label {
    color: #71717a;
    font-size: 0.875em;
    letter-spacing: 0.02em;
  }

  .value {
    font-size: 1em;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .track {
    height: 6px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }

  .fill {
    height: 100%;
    border-radius: 3px;
    background: #c8ff3d;
    transition: width 240ms ease-out;
  }

  .low .fill {
    background: #f87171;
  }

  .low .value {
    color: #f87171;
  }
</style>
