{
  "name": "nexus-ui-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The in-browser sandbox of Nexus UI: edit a .nexus component and see it run.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite build --config vite.frame.config.ts && vite",
    "build": "vite build --config vite.frame.config.ts && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@jridgewell/sourcemap-codec": "^1.6.0",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@preact/signals-core": "^1.14.4",
    "@sveltejs/acorn-typescript": "^1.0.13",
    "acorn": "^8.18.0",
    "magic-string": "^1.4.2",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
