---
import { signal, computed, nui, NuiError } from 'nexus';

const owner = signal('');
const plate = signal('');
const colour = signal<'black' | 'white' | 'lime'>('black');
const insured = signal(false);
const result = signal('');

// Recomputed when a field it reads changes. Only a message that changed is redrawn.
const problems = computed(() => ({
  owner: owner.value.trim().length < 3 ? 'At least 3 characters.' : '',
  plate: /^[A-Z0-9 ]{2,8}$/.test(plate.value) ? '' : '2 to 8 capitals or digits.',
}));
const valid = computed(() => {
  return !problems.value.owner && !problems.value.plate && insured.value;
});

async function register() {
  const input = {
    owner: owner.value.trim(),
    plate: plate.value,
    colour: colour.value,
  };
  try {
    const { fee } = await nui.call('vehicle:register', input);
    result.value = `Registered ${input.plate} for $${fee}.`;
  } catch (error) {
    if (!(error instanceof NuiError)) throw error;
    result.value = `Refused (${error.code}): ${error.message}`;
  }
}
---

<screen focus="mouse keyboard" close="escape" />

<main class="stage">
  <form on:submit|prevent={register}>
    <label>
      <span>Owner</span>
      <input bind:value={owner} maxlength="24" placeholder="Franklin Clinton">
      {#if owner.value && problems.value.owner}
        <em>{problems.value.owner}</em>
      {/if}
    </label>
    <label>
      <span>Plate</span>
      <input bind:value={plate} maxlength="8" placeholder="NX 2024">
      {#if plate.value && problems.value.plate}
        <em>{problems.value.plate}</em>
      {/if}
    </label>
    <label>
      <span>Colour</span>
      <select bind:value={colour}>
        <option value="black">Black</option>
        <option value="white">White</option>
        <option value="lime">Lime, $150 more</option>
      </select>
    </label>
    <label class="check">
      <input type="checkbox" bind:checked={insured}>
      The vehicle is insured
    </label>
    <button disabled={!valid.value || nui.pending('vehicle:register').value}>
      Register
    </button>
    {#if result}
      <p class="result">{result}</p>
    {/if}
  </form>
</main>

<style>
  .stage {
    display: grid;
    place-items: center;
    height: 100%;
    color: #f5f5f5;
    font: 500 14px/1.45 'Inter', 'Segoe UI', system-ui, sans-serif;
  }

  form {
    display: grid;
    gap: 12px;
    box-sizing: border-box;
    width: min(320px, calc(100% - 32px));
    padding: 18px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    background: #111113;
  }

  label {
    display: grid;
    gap: 5px;
  }

  label span {
    color: #71717a;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  input:not([type='checkbox']),
  select {
    box-sizing: border-box;
    width: 100%;
    height: 40px;
    padding: 0 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    background: #1a1a1e;
    color: inherit;
    font: inherit;
    outline: none;
  }

  input:focus,
  select:focus {
    border-color: rgba(200, 255, 61, 0.3);
  }

  em {
    color: #f87171;
    font-size: 12px;
    font-style: normal;
  }

  .check {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #a1a1aa;
  }

  .check input {
    accent-color: #c8ff3d;
  }

  button {
    height: 42px;
    border: 0;
    border-radius: 12px;
    background: #c8ff3d;
    color: #0b1400;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 150ms ease;
  }

  button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .result {
    margin: 0;
    color: #a1a1aa;
  }
</style>
