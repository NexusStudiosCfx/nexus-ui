---
import { signal, onKey } from 'nexus';

const options = ['Repair the engine', 'Change the plate', 'Respray', 'Sell it'];
const index = signal(0);
const chosen = signal('');

function move(by: number) {
  index.value = (index.value + by + options.length) % options.length;
}

// A key with a handler does nothing else: the arrows do not scroll and Enter does
// not click. The handlers are gone when the screen closes.
onKey('ArrowDown', () => move(1));
onKey('ArrowUp', () => move(-1));
onKey('Enter', () => (chosen.value = options[index.value] ?? ''));
onKey('Backspace', () => (chosen.value = ''));
---

<screen focus="mouse keyboard" close="escape" />

<main class="stage">
  <nav class="menu">
    <p class="title">Mechanic</p>
    <ul>
      {#each options as option, position (option)}
        <li
          class:selected={position === index.value}
          on:click={() => (index.value = position)}
        >
          {option}
        </li>
      {/each}
    </ul>
    <p class="hint">
      {#if chosen}
        <strong>{chosen}</strong>, chosen. <kbd>Backspace</kbd> clears it.
      {:else}
        Click here, then <kbd>&uarr;</kbd> <kbd>&darr;</kbd> and <kbd>Enter</kbd>.
        <kbd>Esc</kbd> closes.
      {/if}
    </p>
  </nav>
</main>

<style>
  .stage {
    display: grid;
    place-items: center;
    height: 100%;
    color: #f5f5f5;
    font: 500 14px/1.45 'Inter', 'Segoe UI', system-ui, sans-serif;
  }

  .menu {
    box-sizing: border-box;
    width: min(300px, calc(100% - 32px));
    padding: 14px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    background: #111113;
  }

  .title {
    margin: 2px 6px 10px;
    color: #71717a;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  ul {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 10px 12px;
    border: 1px solid transparent;
    border-radius: 12px;
    color: #a1a1aa;
    cursor: pointer;
    transition: background 120ms ease, color 120ms ease;
  }

  li.selected {
    border-color: rgba(200, 255, 61, 0.3);
    background: rgba(200, 255, 61, 0.12);
    color: #c8ff3d;
  }

  .hint {
    min-height: 42px;
    margin: 12px 6px 0;
    color: #71717a;
    font-size: 12px;
    line-height: 1.7;
  }

  .hint strong {
    color: #f5f5f5;
  }

  kbd {
    padding: 2px 6px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    background: #1a1a1e;
    color: #a1a1aa;
    font: inherit;
  }
</style>
