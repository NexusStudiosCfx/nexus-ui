---
import { signal, computed } from 'nexus';

interface Vehicle {
  plate: string;
  name: string;
  fuel: number;
}

const vehicles: Vehicle[] = [
  { plate: 'NX 101', name: 'Sultan RS', fuel: 82 },
  { plate: 'NX 204', name: 'Bati 801', fuel: 35 },
  { plate: 'NX 318', name: 'Baller', fuel: 64 },
  { plate: 'NX 422', name: 'Comet', fuel: 12 },
  { plate: 'NX 537', name: 'Blista', fuel: 97 },
];

const search = signal('');
const byFuel = signal(false);

const shown = computed(() => {
  const wanted = search.value.trim().toLowerCase();
  const found = vehicles.filter(({ name }) => name.toLowerCase().includes(wanted));
  return byFuel.value ? [...found].sort((a, b) => b.fuel - a.fuel) : found;
});
---

<screen focus="mouse keyboard" close="escape" />

<main class="stage">
  <section class="panel">
    <div class="tools">
      <input bind:value={search} placeholder="Search by name">
      <button class:on={byFuel} on:click={() => (byFuel.value = !byFuel.value)}>
        Most fuel first
      </button>
    </div>
    <ul>
      <!-- The key says which row belongs to which vehicle. Tick a box and sort:
           the row is moved, not built again, so the box stays ticked. -->
      {#each shown as vehicle (vehicle.plate)}
        <li>
          <input type="checkbox" title="Mark {vehicle.name}">
          <span class="name">{vehicle.name}</span>
          <span class="plate">{vehicle.plate}</span>
          <span class="fuel" class:low={vehicle.fuel < 20}>{vehicle.fuel}%</span>
        </li>
      {:else}
        <li class="empty">No vehicle matches "{search}".</li>
      {/each}
    </ul>
  </section>
</main>

<style>
  .stage {
    display: grid;
    place-items: center;
    height: 100%;
    color: #f5f5f5;
    font: 500 14px/1.45 'Inter', 'Segoe UI', system-ui, sans-serif;
  }

  .panel {
    box-sizing: border-box;
    width: min(360px, calc(100% - 32px));
    padding: 14px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    background: #111113;
  }

  .tools {
    display: flex;
    gap: 8px;
    margin-bottom: 10px;
  }

  .tools input,
  .tools button {
    height: 38px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    background: #1a1a1e;
    color: inherit;
    font: inherit;
    outline: none;
  }

  .tools input {
    flex: 1;
    min-width: 0;
    padding: 0 12px;
  }

  .tools input:focus {
    border-color: rgba(200, 255, 61, 0.3);
  }

  .tools button {
    padding: 0 12px;
    color: #a1a1aa;
    white-space: nowrap;
    cursor: pointer;
  }

  .tools button.on {
    border-color: rgba(200, 255, 61, 0.3);
    background: rgba(200, 255, 61, 0.12);
    color: #c8ff3d;
  }

  ul {
    display: grid;
    gap: 2px;
    min-height: 214px;
    margin: 0;
    padding: 0;
    align-content: start;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: auto 1fr auto 44px;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding: 0 10px;
    border-radius: 10px;
  }

  li:hover {
    background: #151518;
  }

  li input {
    accent-color: #c8ff3d;
  }

  .plate {
    color: #71717a;
    font-size: 12px;
  }

  .fuel {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .fuel.low {
    color: #f87171;
  }

  .empty {
    display: block;
    height: auto;
    padding: 12px 10px;
    color: #71717a;
  }
</style>
