---
/** The command that starts a resource, with a button that copies it. */
import { SITE } from '../../site.config.mjs';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['install', className]}>
  <span class="install-prompt" aria-hidden="true">$</span>
  <code>{SITE.install}</code>
  <button type="button" class="install-copy" data-copy={SITE.install}>
    <svg class="icon-copy" viewBox="0 0 16 16" aria-hidden="true">
      <rect x="5.5" y="5.5" width="8" height="8" rx="1.8" fill="none" stroke="currentColor" stroke-width="1.4"></rect>
      <path d="M10.5 3.2V3A1.5 1.5 0 0 0 9 1.5H3A1.5 1.5 0 0 0 1.5 3v6A1.5 1.5 0 0 0 3 10.5h.2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
    </svg>
    <svg class="icon-done" viewBox="0 0 16 16" aria-hidden="true">
      <path d="m3 8.5 3.2 3.2L13 4.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    <span data-copy-label aria-live="polite">Copy</span>
  </button>
</div>

<style>
  .install {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    max-width: 100%;
    height: 52px;
    padding: 0 6px 0 16px;
    border: 1px solid var(--line-2);
    border-radius: 14px;
    background: var(--code);
    font: 500 14px/1 var(--mono);
    transition: border-color 0.2s;
  }

  .install:hover,
  .install:focus-within {
    border-color: var(--accent-ring);
  }

  .install-prompt {
    color: var(--accent);
    user-select: none;
  }

  code {
    overflow: hidden;
    color: var(--ink);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .install-copy {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 7px;
    height: 38px;
    margin-left: 6px;
    padding: 0 12px;
    border: 1px solid var(--line-2);
    border-radius: 10px;
    background: var(--elevated);
    color: var(--muted);
    font: 600 13px/1 var(--font);
    cursor: pointer;
    transition:
      color 0.15s,
      border-color 0.15s,
      background-color 0.15s;
  }

  .install-copy:hover {
    border-color: var(--accent-ring);
    color: var(--ink);
  }

  .install-copy svg {
    width: 15px;
    height: 15px;
  }

  .install-copy .icon-done,
  .install-copy[data-copied] .icon-copy {
    display: none;
  }

  .install-copy[data-copied] {
    border-color: var(--accent-ring);
    background: var(--accent-soft);
    color: var(--accent);
  }

  .install-copy[data-copied] .icon-done {
    display: block;
  }

  @media (max-width: 420px) {
    .install {
      gap: 8px;
      padding-left: 12px;
      font-size: 12.5px;
    }

    .install-copy {
      padding: 0 10px;
    }

    .install-copy span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
  }
</style>
