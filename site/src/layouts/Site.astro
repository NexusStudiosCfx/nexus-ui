---
/**
 * Layout of the pages outside the docs: the landing page, the playground and the 404. The docs
 * use Starlight's layout with the same colours (src/styles/docs.css).
 */
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/site.css';
import '../styles/chrome.css';
import '../styles/shared.css';
import '../styles/code.css';
import symbol from '../assets/brand/symbol.png';
import GitHubIcon from '../components/GitHubIcon.astro';
import { href, socialImage } from '../lib/paths';
import { VERSION } from '../lib/project';
import { SITE } from '../../site.config.mjs';

interface Props {
  title?: string;
  description?: string;
  /** The name of the social image of the page, under src/pages/og. */
  image?: string;
  /** A page that fills the window and has no footer, such as the playground. */
  bare?: boolean;
}

const { title, description = SITE.description, image = '', bare = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}: a UI framework for FiveM resources`;
const origin = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL(socialImage(image), origin).href;
const path = Astro.url.pathname;

const NAV = [
  { label: 'Why', to: href('/#why') },
  { label: 'How it works', to: href('/#how') },
  { label: 'Docs', to: href('/docs/') },
  { label: 'Playground', to: href('/playground/') },
];
const DOCS = [
  { label: 'Guide', to: href('/docs/guide/') },
  { label: 'The .nexus format', to: href('/docs/format/') },
  { label: 'The bridge', to: href('/docs/bridge/') },
  { label: 'Command line', to: href('/docs/cli/') },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09090b" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="64x64" href={href('/favicon.png')} />
    <link rel="icon" type="image/png" sizes="32x32" href={href('/favicon-32.png')} />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="preload" as="font" type="font/woff2" href={interUrl} crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class:list={{ bare }}>
    <a class="skip" href="#main">Skip to the content</a>
    <header class="top">
      <div class="wrap top-in">
        <a class="brand" href={href('/')}>
          <img src={symbol.src} alt="" width="24" height="28" />
          {SITE.name}
        </a>
        <nav class="nav" aria-label="Main">
          {NAV.map((item) => <a href={item.to} aria-current={path === item.to ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <div class="top-actions">
          <a class="version hide-sm" href={href('/docs/changelog/')} title="Changelog">v{VERSION}</a>
          <a class="btn btn-ghost btn-sm" href={SITE.repository} rel="noopener" aria-label="Nexus UI on GitHub">
            <GitHubIcon />
            <span class="hide-sm">GitHub</span>
          </a>
          <a class="btn btn-primary btn-sm hide-sm" href={href('/docs/guide/')}>Get started</a>
          <details class="mnav">
            <summary aria-label="Menu">
              <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 9h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
            </summary>
            <nav class="mnav-panel" aria-label="Menu">
              {NAV.map((item) => <a href={item.to}>{item.label}</a>)}
              <a href={href('/docs/guide/')}>Get started</a>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    {
      !bare && (
        <footer class="foot">
          <div class="wrap foot-in">
            <div class="foot-brand">
              <a class="brand" href={href('/')}>
                <img src={symbol.src} alt="" width="24" height="28" loading="lazy" />
                {SITE.name}
              </a>
              <p>A UI framework for FiveM resources, by Nexus Studios. Open source under the MIT licence.</p>
            </div>
            <div class="foot-cols">
              <div>
                <h4>Docs</h4>
                {DOCS.map((item) => <a href={item.to}>{item.label}</a>)}
              </div>
              <div>
                <h4>Project</h4>
                <a href={SITE.repository}>GitHub</a>
                <a href={SITE.npm}>npm: {SITE.package}</a>
                <a href={SITE.npmInitializer}>npm: {SITE.initializer}</a>
                <a href={SITE.license}>MIT licence</a>
                <a href={SITE.issues}>Issues</a>
              </div>
              <div>
                <h4>More</h4>
                <a href={href('/playground/')}>Playground</a>
                <a href={SITE.example}>Example resource</a>
                <a href={href('/docs/roadmap/')}>Roadmap</a>
                <a href={href('/docs/changelog/')}>Changelog</a>
              </div>
            </div>
          </div>
          <div class="wrap foot-legal">
            <p>
              © {new Date().getFullYear()} Nexus Studios. Nexus UI is not affiliated with Cfx.re, Rockstar Games or LB, the maker of LB Phone and LB Tablet.
            </p>
          </div>
        </footer>
      )
    }

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
