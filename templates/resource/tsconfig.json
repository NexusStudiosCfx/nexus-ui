{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "paths": {
      "nexus": ["./node_modules/nexus-ui/dist/runtime/index.d.ts"],
      "nexus/contract": ["./node_modules/nexus-ui/dist/contract/index.d.ts"]
    }
  },
  "include": ["web"]
}
